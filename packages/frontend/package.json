{
  "name": "@vibbr.co/frontend",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "Expo / React Native / Expo Router universal app for Vibbr",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "expo start --clear",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "test": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .expo"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@oxy\\.so/bloom|@vibbr\\.co))"
    ]
  },
