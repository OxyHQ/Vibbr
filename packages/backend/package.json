{
  "name": "@vibbr.co/backend",
  "version": "1.0.0",
  "description": "Express 5 / Drizzle on PostgreSQL backend for Vibbr: events, tickets and resale",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "bun test --no-env-file --isolate ./src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=0 --hot-tables=tickets,orders,ticket_types,events",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@oxy.so/contracts": "catalog:",
    "@oxy.so/core": "catalog:",
    "@oxy.so/db": "^1.5.0",
    "@vibbr.co/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/express": "^5.0.0",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:"
  }
}
