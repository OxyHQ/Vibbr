{
  "name": "vibbr",
  "version": "0.1.0",
  "description": "Vibbr: events, tickets and resale",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@oxy.so/contracts": "7.5.0",
      "@oxy.so/core": "7.55.0",
      "@types/bun": "1.4.4",
      "@types/node": "^26.6.6",
      "typescript": "~6.0.3",
      "zod": "^4.6.7",
      "@oxy.so/bloom": "22.1.7",
      "@oxy.so/services": "14.24.0",
      "@oxy.so/utils": "^1.5.2",
      "@oxy.so/protocol": "1.11.1"
    }
  },
  "scripts": {
    "dev": "bun run --no-orphans --filter '*' dev",
    "dev:backend": "bun run --no-orphans --cwd packages/backend dev",
    "build": "bun run build:contracts && bun run build:publishing && bun run --cwd packages/backend build",
    "build:contracts": "bun run --cwd packages/contracts build",
    "build:publishing": "bun run --cwd packages/sdk build",
    "build:backend": "bun run build:contracts && bun run --cwd packages/backend build",
    "doctor": "bun ./scripts/doctor.mjs",
    "doctor:oxy": "oxy-doctor --ci",
    "check": "bun run check:workspace && bun run build && bun run check:types",
    "check:workspace": "bun run --parallel doctor validate:lockfile validate:license validate:bun-pins",
    "check:types": "bun run --parallel lint:backend typecheck:frontend",
    "test": "bun run --parallel test:contracts test:sdk test:backend test:frontend",
    "test:backend": "bun run --cwd packages/backend test",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:sdk": "bun run --cwd packages/sdk test",
    "validate:lockfile": "bun ./scripts/validate-lockfile.mjs",
    "validate:license": "bun ./scripts/validate-license.mjs",
    "validate:bun-pins": "bun ./scripts/validate-bun-pins.mjs && bun ./scripts/test-validate-bun-pins.mjs",
    "lint": "biome check . && bun run --parallel lint:backend lint:frontend",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:backend": "bun run --cwd packages/backend lint",
    "start:backend": "bun run --cwd packages/backend start",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "postinstall": "bun run build:contracts && bun run build:publishing",
    "dev:frontend": "bun run --no-orphans --cwd packages/frontend dev",
    "start:frontend": "bun run --cwd packages/frontend start",
    "build:frontend": "bun run --cwd packages/frontend build",
    "typecheck:frontend": "bun run --cwd packages/frontend typecheck",
    "test:frontend": "bun run --cwd packages/frontend test",
    "lint:frontend": "bun run --cwd packages/frontend lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@oxy.so/doctor": "1.10.0",
    "@types/node": "catalog:",
    "semver": "^7.8.6",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@expo/cli": "58.1.19",
    "body-parser": "2.4.0",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "expo-file-system": "58.0.13",
    "expo-modules-core": "58.0.30",
    "expo-asset": "58.0.20",
    "expo-linking": "58.0.16",
    "@expo/log-box": "58.0.15",
    "expo": "58.0.23",
    "react-native-svg": "15.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-babel-transformer": "0.88.1",
    "metro": "0.87.1",
    "metro-babel-transformer": "0.87.1",
    "metro-cache": "0.87.1",
    "metro-cache-key": "0.87.1",
    "metro-config": "0.87.1",
    "metro-core": "0.87.1",
    "metro-file-map": "0.87.1",
    "metro-minify-terser": "0.87.1",
    "metro-resolver": "0.87.1",
    "metro-runtime": "0.87.1",
    "metro-source-map": "0.87.1",
    "metro-symbolicate": "0.87.1",
    "metro-transform-plugins": "0.87.1",
    "metro-transform-worker": "0.87.1",
    "ob1": "0.87.1",
    "@oxy.so/bloom": "catalog:",
    "@oxy.so/core": "7.55.0",
    "@oxy.so/services": "14.24.0",
    "fast-uri": "3.1.9",
    "fast-xml-parser": "5.12.0",
    "ioredis": "6.0.0",
    "postcss": "8.5.32",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "ip-address": "10.7.6",
    "socket.io-parser": "4.2.7",
    "nanoid": "3.3.20",
    "browserslist": "4.29.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/query-core": "5.105.3",
    "@tanstack/query-persist-client-core": "5.105.3",
    "@tanstack/query-async-storage-persister": "5.105.3",
    "@tanstack/react-query-persist-client": "5.105.3",
    "@oxy.so/contracts": "catalog:",
    "@grpc/grpc-js": "1.14.7",
    "@fastify/busboy": "3.2.4",
    "@oxy.so/protocol": "catalog:",
    "react-native-css": "3.1.0-rc.0",
    "vite": "8.3.5"
  },
  "patchedDependencies": {
    "react-native-css@3.1.0-rc.0": "patches/react-native-css@3.1.0-rc.0.patch",
    "@shopify/flash-list@2.3.3": "patches/@shopify%2Fflash-list@2.3.3.patch",
    "react-native-screens@4.30.1": "patches/react-native-screens@4.30.1.patch",
    "react-native@0.88.1": "patches/react-native@0.88.1.patch",
    "react-native-gesture-handler@3.4.0": "patches/react-native-gesture-handler@3.4.0.patch",
    "expo-router@58.0.30": "patches/expo-router@58.0.30.patch"
  }
}
